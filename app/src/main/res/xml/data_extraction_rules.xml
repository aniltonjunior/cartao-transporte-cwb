<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ (API 31+): regras de backup na nuvem e de transferência entre
    aparelhos. As credenciais ficam fora dos dois: a chave que as decifra mora
    no Android Keystore e não é copiada, então o arquivo restaurado seria
    ilegível.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="credenciais_urbs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="credenciais_urbs.xml" />
    </device-transfer>
</data-extraction-rules>
